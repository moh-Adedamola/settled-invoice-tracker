{
  "name": "invoice-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "set-password": "tsx --conditions=react-server --env-file=.env.local scripts/set-password.ts",
    "test-webhook": "tsx --conditions=react-server --env-file=.env.local scripts/test-webhook.ts",
    "test-drain": "tsx --conditions=react-server --env-file=.env.local scripts/test-drain.ts",
    "test-reset": "tsx --conditions=react-server --env-file=.env.local scripts/test-reset.ts",
    "check:pdf": "esbuild scripts/check-pdf-text.tsx --bundle --platform=node --format=esm --target=node22 --conditions=react-server --alias:@=./src --external:@react-pdf/renderer --external:@neondatabase/serverless --external:react --outfile=node_modules/.cache/settled/check-pdf-text.mjs --log-level=warning && node --env-file-if-exists=.env.local node_modules/.cache/settled/check-pdf-text.mjs",
    "test-money": "tsx scripts/test-money.ts",
    "test-brand-raster": "tsx scripts/test-brand-raster.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
